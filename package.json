{
  "name": "archy-afk",
  "private": true,
  "version": "1.0.0",
  "description": "Minecraft AFK bot yonetimi icin profesyonel Windows masaustu uygulamasi.",
  "author": "Apeiron_Only",
  "type": "module",
  "productName": "ArchyAfk",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "prebuild": "node scripts/clean-build.mjs",
    "dev": "node scripts/dev-electron.mjs",
    "dev:renderer": "vite --host 127.0.0.1",
    "build:main": "tsc -p tsconfig.electron.json \u0026\u0026 node scripts/write-electron-package.mjs",
    "build:renderer": "tsc -p tsconfig.app.json \u0026\u0026 vite build",
    "build": "npm run build:main \u0026\u0026 npm run build:renderer \u0026\u0026 electron-builder",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.90.6",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.545.0",
    "minecraft-protocol": "^1.66.2",
    "mineflayer": "^4.37.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.65.0",
    "react-router": "^7.9.4",
    "react-router-dom": "^7.9.4",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/node": "^24.8.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vite": "^7.1.11",
    "wait-on": "^9.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "electron-winstaller@5.4.0": true
  },
  "overrides": {
    "uuid": "^11.1.0"
  },
  "build": {
    "appId": "com.archyafk.desktop",
    "productName": "ArchyAfk",
    "directories": {
      "output": "dist"
    },
    "compression": "maximum",
    "electronLanguages": [
      "tr",
      "en-US"
    ],
    "files": [
      "build/renderer/**/*",
      "dist-electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "assets/logo.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "executableName": "ArchyAfk"
    },
    "nsis": {
      "artifactName": "ArchyAfk-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ArchyAfk"
    },
    "portable": {
      "artifactName": "ArchyAfk-Portable-${version}-${arch}.${ext}"
    }
  }
}
